import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.datasets import load_iris
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA

# Load the Iris dataset
iris = load_iris()
X = iris.data

# Standardize features before PCA
X_scaled = StandardScaler().fit_transform(X)

# Fit PCA with all components to inspect variance
full_pca = PCA()
full_pca.fit(X_scaled)
variance_ratio = full_pca.explained_variance_ratio_
cumulative_variance = np.cumsum(variance_ratio)

# Display variance preserved by each component
summary = pd.DataFrame({
    "Component": ["PC1", "PC2", "PC3", "PC4"],
    "Explained Variance Ratio": variance_ratio,
    "Cumulative Variance": cumulative_variance
})
print(summary.round(4).to_string(index=False))

# Find how many components preserve at least 95 percent variance
components_95 = np.argmax(cumulative_variance >= 0.95) + 1
print("\nComponents needed for 95% variance:", components_95)

# Reduce four features to two principal components
pca = PCA(n_components=2)
X_pca = pca.fit_transform(X_scaled)

print("\nOriginal shape:", X.shape)
print("Reduced shape:", X_pca.shape)
print("Variance preserved by two components:",
      round(pca.explained_variance_ratio_.sum() * 100, 2), "%")
print("\nFIRST FIVE TRANSFORMED ROWS")
print(pd.DataFrame(X_pca, columns=["PC1", "PC2"]).head())

# Plot cumulative explained variance
plt.plot(range(1, 5), cumulative_variance, marker="o")
plt.axhline(0.95, color="red", linestyle="--", label="95% variance")
plt.xlabel("Number of Components")
plt.ylabel("Cumulative Explained Variance")
plt.xticks(range(1, 5))
plt.title("PCA Variance Preservation")
plt.legend()
plt.grid(True, alpha=0.3)
plt.show()

# Use class labels only to color the visualization
for label, name in enumerate(iris.target_names):
    points = X_pca[iris.target == label]
    plt.scatter(points[:, 0], points[:, 1], label=name)

plt.xlabel("Principal Component 1")
plt.ylabel("Principal Component 2")
plt.title("Iris Dataset After PCA")
plt.legend()
plt.show()
